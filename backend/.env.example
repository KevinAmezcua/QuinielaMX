# Copia este archivo como .env y llena los valores.

# Cadena de conexión de MongoDB (Atlas o local)
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/quiniela

# Secreto para firmar los tokens de admin. Usa una cadena larga y aleatoria:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Contraseña del panel de administración
ADMIN_PASSWORD=

# Opcionales ------------------------------------------------------------------

# Puerto del servidor (Render lo define automáticamente)
# PORT=3000

# Orígenes permitidos para CORS, separados por comas.
# Si se deja vacío se acepta cualquier origen.
# ALLOWED_ORIGINS=https://tu-usuario.github.io,http://localhost:5500

# Zona horaria en que se capturan fecha/hora de los partidos (cierre automático de envíos)
# TZ_OFFSET=-06:00

# Número de proxies delante del servidor (Render = 1). Usa 0 en local sin proxy.
# TRUST_PROXY=1
